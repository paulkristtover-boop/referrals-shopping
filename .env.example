# Client (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_DEPOSIT_TRX=TYourTRXAddress
VITE_DEPOSIT_SOL=YourSOLAddress
VITE_DEPOSIT_TON=EQYourTONAddress

# Server (Vercel — never expose service role to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DEPOSIT_TRX=TYourTRXAddress
DEPOSIT_SOL=YourSOLAddress
DEPOSIT_TON=EQYourTONAddress
TRONGRID_API_KEY=
HELIUS_API_KEY=
TONCENTER_API_KEY=
CRON_SECRET=optional-random-string
RATE_TRX_USD=0.12
RATE_SOL_USD=150
RATE_TON_USD=5

# Naira → USD for crypto quotes
VITE_NGN_PER_USD=1600
NGN_PER_USD=1600

# Flutterwave (server only for secret — never expose FLW_SECRET_KEY to Vite)
FLW_PUBLIC_KEY=FLWPUBK_TEST_xxx
FLW_SECRET_KEY=FLWSECK_TEST_xxx
FLW_SECRET_HASH=your-webhook-secret-hash
APP_URL=https://your-domain.vercel.app
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST_xxx
